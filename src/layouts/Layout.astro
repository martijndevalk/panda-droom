---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
const rawBase = import.meta.env.BASE_URL || '/';
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const isProd = import.meta.env.PROD;
---

<!DOCTYPE html>
<html lang="nl" data-theme="pandadroom" data-base-url={base}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content="Leer tafels met Panda! Een vriendelijke reken-app voor kinderen." />
    <meta name="theme-color" content="#FFF8F0" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Panda Droom" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="apple-touch-icon" href={`${base}panda-icon-512.png`} />
    <link rel="manifest" href={`${base}manifest.json`} />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="m-0 p-0 bg-light select-none font-sans flex flex-col min-h-0 overflow-hidden">
    <slot />
    {isProd ? (
      <script is:inline>
        if ('serviceWorker' in navigator) {
          window.addEventListener('load', () => {
            const base = document.documentElement.getAttribute('data-base-url') || '/';
            navigator.serviceWorker.register(`${base}sw.js`, { updateViaCache: 'none' }).catch(() => {});
          });
        }
      </script>
    ) : (
      <script is:inline>
        if ('serviceWorker' in navigator) {
          navigator.serviceWorker.getRegistrations().then((registrations) => {
            for (const registration of registrations) {
              registration.unregister();
            }
          });
          if ('caches' in window) {
            caches.keys().then((keys) => {
              for (const key of keys) {
                if (key.startsWith('panda-droom')) {
                  caches.delete(key);
                }
              }
            });
          }
        }
      </script>
    )}
  </body>
</html>
